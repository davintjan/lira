<mujoco model="lira world">
  <!-- The shared world -- table, Push-T block, goal, moving obstacle -- without a robot. Each
       scene_<robot>.xml includes its robot and then this file, so every arm gets the identical
       scene. The robot's base sits at the world origin, which is the tabletop surface (below). -->

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.55 0.4 0.28 1"/>
    <material name="tblock_mat" rgba="0.85 0.1 0.1 1"/>
    <material name="target_mat" rgba="0.1 0.7 0.1 0.35"/>
    <material name="obstacle_mat" rgba="0.95 0.75 0.1 0.6"/>
  </asset>

  <!--
    Each robot's own "base" body (from its menagerie xml) is fixed with no positional offset,
    so it sits exactly at the world origin. Rather than edit the robot xml to mount it on
    a pedestal, this scene treats the world origin as the tabletop surface: the
    table box below has its top face at z=0, so the robot ends up base-mounted on
    the table, and everything else (T-block, target) is placed at z=0 (on the
    table) in front of it.
  -->
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 -0.75" type="plane" material="groundplane"/>

    <!-- Tabletop: 1.2m x 1.0m x 0.05m thick, top surface at z=0 -->
    <body name="table" pos="0 0 -0.025">
      <geom name="table_top" type="box" size="0.6 0.5 0.025" material="table_mat"/>
    </body>

    <!-- Push-T block: a flat T-shaped puck resting on the tabletop, free to be pushed around.
         Built exactly like Push-T's T (diffusion_policy/env/pusht/pusht_env.py add_tee, at
         1 px = 1 mm) and in its local frame: the body origin is the middle of the bar's outer
         edge, the bar spans local y in [0, 30] mm and the stem y in [30, 120] mm. So the body's
         pose is Push-T's block pose directly (ur5_pusht_sim.PushTFrame). Yaw 180 deg keeps the
         bar on the far (+y) side with the stem pointing toward -y. -->
    <body name="t_block" pos="0.4 0.21 0.02" quat="0 0 0 1">
      <freejoint/>
      <!-- density 4000 kg/m^3 -> 1.0 kg in all (MuJoCo's default 1000 made it 0.25 kg, light enough to fly off the rod) -->
      <geom name="t_bar" type="box" size="0.06 0.015 0.02" pos="0 0.015 0" density="4000" material="tblock_mat"/>
      <geom name="t_stem" type="box" size="0.015 0.045 0.02" pos="0 0.075 0" density="4000" material="tblock_mat"/>
    </body>

    <!-- Goal: Push-T's fixed goal pose (256, 256 px, 45 deg), placed where the Push-T workspace
         maps onto this table -- ur5_pusht_sim.PushTFrame reads this body to set the mapping, so it's
         the one place that decides where the workspace is. Same T shape and local frame as the
         block. Visual only (no collision), a flat semi-transparent green T on the tabletop. -->
    <body name="goal" pos="0.4 -0.025 0.001" quat="0.9238795 0 0 0.3826834">
      <geom name="goal_bar" type="box" size="0.06 0.015 0.001" pos="0 0.015 0" material="target_mat"
        contype="0" conaffinity="0"/>
      <geom name="goal_stem" type="box" size="0.015 0.045 0.001" pos="0 0.075 0" material="target_mat"
        contype="0" conaffinity="0"/>
    </body>

    <!-- Moving obstacle: a floating ellipsoid, moved by code rather than physics (mocap) --
         scene.MovingObstacle sweeps it back and forth through the arm's path at constant speed.
         It still collides, so if the CBF ever fails to keep the arm clear, the arm really gets hit. -->
    <body name="obstacle" mocap="true" pos="0.3 0 0.4">
      <geom name="obstacle" type="ellipsoid" size="0.10 0.06 0.05" material="obstacle_mat"/>
    </body>
  </worldbody>
</mujoco>
