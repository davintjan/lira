<mujoco model="iiwa14 lira scene">
  <!-- KUKA iiwa 14 on the shared world (world.xml). Includes a symlink wrapper (_vendor/, generated by
       generate_vendor_links.py, gitignored) instead of ../../mujoco_menagerie directly: MuJoCo's
       <include> resolves a plain-filename <mesh file="..."/> relative to the directory of the file
       that declares it, but ignores that file's (or the root's) <compiler meshdir="..."/> -- so a
       bare cross-directory include can't find the robot's meshes. The wrapper puts the robot xml
       and its meshes side by side so MuJoCo's resolution just works. mujoco_menagerie itself is
       never touched -- re-run generate_vendor_links.py after updating that submodule. -->
  <include file="_vendor/kuka_iiwa_14/iiwa14.xml"/>
  <include file="world.xml"/>
</mujoco>
