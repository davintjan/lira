<mujoco model="ur5e pusht scene">
  <!-- Pulls in ur5e.xml's <compiler>, <default>, <worldbody>, <actuator>, etc.
       verbatim from the sibling mujoco_menagerie fork -- nothing here edits that
       repo. Relative asset paths inside an included file (meshdir="assets" in
       ur5e.xml) resolve relative to that included file's own directory, not this
       one, as of MuJoCo >= 2.3.3 -- requires a reasonably current mujoco. -->
  <include file="../mujoco_menagerie/universal_robots_ur5e/ur5e.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.55 0.4 0.28 1"/>
    <material name="tblock_mat" rgba="0.85 0.1 0.1 1"/>
    <material name="target_mat" rgba="0.1 0.7 0.1 0.35"/>
  </asset>

  <!--
    UR5e's own "base" body (from ur5e.xml) is fixed with no positional offset, so
    it sits exactly at the world origin. Rather than edit ur5e.xml to mount it on
    a pedestal, this scene treats the world origin as the tabletop surface: the
    table box below has its top face at z=0, so the robot ends up base-mounted on
    the table, and everything else (T-block, target) is placed at z=0 (on the
    table) in front of it.
  -->
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 -0.75" type="plane" material="groundplane"/>

    <!-- Tabletop: 1.2m x 1.0m x 0.05m thick, top surface at z=0 -->
    <body name="table" pos="0 0 -0.025">
      <geom name="table_top" type="box" size="0.6 0.5 0.025" material="table_mat"/>
    </body>

    <!-- Push-T block: a flat T-shaped puck resting on the tabletop, free to be
         pushed around. Two boxes (top bar + stem) forming a "T" in the XY plane. -->
    <body name="t_block" pos="0.4 0.15 0.02">
      <freejoint/>
      <geom name="t_bar" type="box" size="0.06 0.015 0.02" pos="0 0.045 0" material="tblock_mat"/>
      <geom name="t_stem" type="box" size="0.015 0.06 0.02" pos="0 -0.03 0" material="tblock_mat"/>
    </body>

    <!-- Target region: where the T-block should be pushed to. Visual only
         (no collision), semi-transparent green outline on the tabletop. -->
    <geom name="target_region" type="box" size="0.08 0.08 0.001" pos="0.4 -0.2 0.001"
      material="target_mat" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
